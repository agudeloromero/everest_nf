/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the full-size cohort run: real, un-subsampled data covering every
    input pathway in one run.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Samples (assets/test_samplesheets/cohort_full.csv): SR PE DNA x2, SR PE RNA, SR SE DNA,
    SR SE RNA, LR Nanopore, LR PacBio, plus two contig-only samples (a real rep_seq set and
    the lambda+blaTEM-1 AMR positive control).

    Unlike the test_* profiles this keeps the production defaults: no subsampling, no
    SEQKIT_FILTER -m override (production cut-off), keep_lambda=false so ONT lambda control
    reads are removed. The reads must be staged first (docs/cluster-resume/stage-cohort-full.sh);
    run it on the cluster with docs/cluster-resume/configs/seedling-full.config.

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile cohort_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

params {
    config_profile_name        = 'Full cohort profile'
    config_profile_description = 'Real full-size data: SR PE/SE (DNA+RNA), LR ONT/PacBio, contigs'

    input        = "${projectDir}/assets/test_samplesheets/cohort_full.csv"

    // test_data.config sets this true for the lambda-based tests; real ONT data must have its
    // lambda control reads removed.
    keep_lambda  = false
}
