/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the AMR positive-control test: pre-assembled contig made of the
    lambda genome plus the 861 bp blaTEM-1 gene (from abricate's bundled ncbi db)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The lambda-only tests report 0 abricate hits; this one checks that ABRICATE_RUN reports
    blaTEM-1 (100% coverage/identity) and that ABRICATE_SUMMARY counts it (NUM_FOUND = 1).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test_amr,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '4.h'
    ]
    withName: SEQKIT_FILTER {
        ext.args = "-m 300"
    }
}

params {
    config_profile_name        = 'Test profile: AMR positive control'
    config_profile_description = 'pre-assembled contig: lambda genome + blaTEM-1'

    input  = "${projectDir}/assets/test_samplesheets/test_amr.csv"
}
