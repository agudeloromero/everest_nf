/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running subsampled multi-modality tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    All three input modalities on subsampled data: 2 lambda-spiked short-read samples,
    2 long-read samples (lambda + a subsampled Nanopore run) and 1 pre-assembled contig.
    Reads and databases are staged on the seedling cluster MinIO (see conf/test_data.config
    and assets/test_samplesheets/test_sub.csv).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test_sub,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '4.h'
    ]
    withName: SEQKIT_FILTER {
        ext.args = "-m 300"
    }
}

params {
    config_profile_name        = 'Subsampled test profile'
    config_profile_description = 'Subsampled short-read, long-read and contig inputs to check pipeline function'

    // Input data
    input  = "${projectDir}/assets/test_samplesheets/test_sub.csv"
}
