/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Databases and references shared by the test profiles (test, test_sub, test_full)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Staged on the seedling cluster MinIO (bucket su-everest-nf). Staged from
    tki-acacia:pub-everest/db_dir/everest (virsorter/pharokka are not used by live code
    and are not staged). Point at another copy with:
        export EVEREST_TESTDATA_BASE=s3://<bucket>/<prefix>
----------------------------------------------------------------------------------------
*/

params {
    // Subsampled reads/contigs used by the test samplesheets live under
    // <base>/test_data/ (see assets/test_samplesheets/); databases under <base>/db_dir/everest/.
    adaptor                    = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/adaptors/adaptors.fa'
    baltimore_db               = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/DB_Baltimore/Baltimore_group_ICT_2024_20250225_v3.txt'
    checkv_db                  = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/DB_checkv/checkv-db-v1.1'
    mmseq_viral_db_aa          = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/DB_MMSEQ2_aa'
    mmseq_viral_db_aa_ref_name = 'viral.aa.fnaDB'
    mmseq_viral_db_nt          = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/DB_MMSEQ2_nt'
    mmseq_viral_db_nt_ref_name = 'viral.nt.fnaDB'
    tax_aa                     = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/TAX_aa'
    tax_nt                     = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/TAX_nt'

    // Host genome (hg19, minimap2 index is built from it) and transcriptome/cDNA
    genome                     = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/genome/male.hg19.fasta'
    fasta                      = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/genome/Homo_sapiens.GRCh38.cdna.all.fa'
    transcriptome              = (System.getenv('EVEREST_TESTDATA_BASE') ?: 's3://su-everest-nf/shared/everest') + '/db_dir/everest/genome/Homo_sapiens.GRCh38.cdna.all.fa'

    // Large databases (checkv, mmseqs, taxonomy) are read in place from the nf-work host volume
    // on the seedling workers instead of being staged per task (see subworkflows/local/db_inputs).
    // Disabled automatically when EVEREST_TESTDATA_BASE points at another copy; override with
    // EVEREST_DB_MOUNT=<dir>.
    db_mounted_dir             = System.getenv('EVEREST_DB_MOUNT') ?: (System.getenv('EVEREST_TESTDATA_BASE') ? null : '/nxf-work/db/everest')

    keep_lambda                = true
}
