/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Smallest end-to-end check: ONE lambda-spiked short-read sample + ONE lambda long-read
    sample (covers both read types through host removal, assembly/NANOQ, CheckV, taxonomy
    and the summaries). Reads and databases are staged on the seedling cluster MinIO
    (see conf/test_data.config and assets/test_samplesheets/test.csv).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '4.h'
    ]
    // Subsampled data yields short contigs; the production cut-off is -m 3000.
    withName: SEQKIT_FILTER {
        ext.args = "-m 300"
    }
}

params {

    max_cpus = 8
    max_memory = '32.GB'
    max_time = '4.h'

    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset (1 spiked short-read + 1 lambda long-read sample) to check pipeline function'

    // Input data
    input  = "${projectDir}/assets/test_samplesheets/test.csv"
}
