/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    All input pathways in one run: paired-end short reads, single-end short reads, Oxford
    Nanopore long reads and a pre-assembled contig (all lambda-based), through host removal,
    assembly/NANOQ, CheckV, taxonomy and the summaries. Each pathway also has its own
    profile (test_sr_pe, test_sr_se, test_lr, test_contig). Reads and databases are staged on the seedling cluster MinIO
    (see conf/test_data.config and assets/test_samplesheets/test.csv).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '4.h'
    ]
    // Subsampled data yields short contigs; the production cut-off is -m 3000.
    withName: SEQKIT_FILTER {
        ext.args = "-m 300"
    }
}

params {

    max_cpus = 8
    max_memory = '32.GB'
    max_time = '4.h'

    config_profile_name        = 'Test profile'
    config_profile_description = 'Combined test: PE + SE short reads, ONT long reads and a contig, to check every input pathway'

    // Input data
    input  = "${projectDir}/assets/test_samplesheets/test.csv"
}
