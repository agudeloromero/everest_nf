/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Unsubsampled reads: 2 short-read samples, 1 Nanopore sample and 1 contig.

    NOTE: the full-size reads are NOT staged yet. Copy them from
    tki-acacia:pub-everest/data_test/{SR_PE/DNA/pass,LR_NP} to
    s3://su-everest-nf/shared/everest/test_data/reads_full/{shortreads,longreads_np}/
    (keeping the PRJ sub-folders) before using this profile. Databases are shared with the
    other test profiles (conf/test_data.config).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test dataset to check pipeline function'

    // Input data for full size test
    input = "${projectDir}/assets/test_samplesheets/test_full.csv"
}
