/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Unsubsampled reads: 2 short-read PE DNA samples, 1 short-read PE RNA sample (SRR8322173),
    1 short-read SE RNA sample (ERR2732537), 1 Nanopore sample and 1 contig.

    The reads are staged under s3://su-everest-nf/shared/everest/test_data/reads_full/
    (docs/cluster-resume/stage-cohort-full.sh; same files as the cohort_full profile).
    Databases are shared with the other test profiles (conf/test_data.config).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test dataset to check pipeline function'

    // Input data for full size test
    input = "${projectDir}/assets/test_samplesheets/test_full.csv"
}
