/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the single-pathway test: pre-assembled contigs (lambda genome)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reads and databases are staged on the seedling cluster MinIO (see conf/test_data.config
    and assets/test_samplesheets/test_contig.csv).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test_contig,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '4.h'
    ]
    // Subsampled data yields short contigs; the production cut-off is -m 3000.
    withName: SEQKIT_FILTER {
        ext.args = "-m 300"
    }
}

params {
    config_profile_name        = 'Test profile: contig'
    config_profile_description = 'pre-assembled contigs (lambda genome)'

    input  = "${projectDir}/assets/test_samplesheets/test_contig.csv"
}
