/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the single-pathway test: single-end short reads (lambda-spiked, R1 only)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reads and databases are staged on the seedling cluster MinIO (see conf/test_data.config
    and assets/test_samplesheets/test_sr_se.csv).

    Use as follows:
        nextflow run agudeloromero/everest_nf -profile test_sr_se,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_data.config'

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '4.h'
    ]
    // Subsampled data yields short contigs; the production cut-off is -m 3000.
    withName: SEQKIT_FILTER {
        ext.args = "-m 300"
    }
}

params {
    config_profile_name        = 'Test profile: sr_se'
    config_profile_description = 'single-end short reads (lambda-spiked, R1 only)'

    input  = "${projectDir}/assets/test_samplesheets/test_sr_se.csv"
}
