/*
 * Process config for everest_nf on the abc-cluster seedling-prod (namespace su-everest-nf).
 * Merge at run time:
 *   abc pipeline run everest_nf -r vrhyme-summaries \
 *     --params-file params.seedling.yaml --config seedling.config --env NXF_VER=25.10.5
 *
 * The executor / Nomad pools / S3 work dir are configured by `abc pipeline run`
 * itself — do NOT set executor or workDir here.
 *
 * Resource ceiling MUST fit the seedling `standard` compute nodes, which are
 * small VMs: nomad01 = 8 cores / 7.9 GB, nomad02 = 24 cores / 24 GB,
 * nomad03 = 16 cores / 20 GB. everest's conf/base.config requests 36 GB
 * (process_medium), 72 GB (process_high) and 200 GB (process_high_memory) —
 * none of which fit — so without this cap every heavy task hits
 * "Placement Failure: memory exhausted on 3 nodes". The 16 GB cap fits nomad02
 * and nomad03 (with headroom for Nomad's reserved overhead) and is enough for
 * GRCh38 minimap2 indexing and SPADES on the subsampled SMOKE test data.
 * Raise per-label (withName) only if a specific step OOMs, and revisit entirely
 * for full-data runs (the OCI/Setonix config used 150 GB for SPADES and
 * 200 GB for process_high_memory).
 */

// The seedling cluster is only 3 small compute nodes (8/24/20 GB). The 4-sample
// fan-out in cleaning-contigs/taxonomy (CheckV splits each sample into several
// contig files) submits ~12 heavy 12-16 GB tasks at once; they can't all be placed,
// and queued tasks hit nf-nomad's ~5 min placement timeout and FAIL ("failed
// placement: insufficient resources"). Throttle how many tasks are in flight so the
// queue never exceeds what the nodes can actually schedule. Lower = safer but slower.
executor {
    // Only nomad02 (24 GB) + nomad03 (20 GB) reliably take heavy tasks (~44 GB usable);
    // at ~12-16 GB/task that is ~2-3 concurrent. queueSize=5 still over-subscribed and
    // produced repeated 'failed placement' retries. Cap at 3 so the in-flight heavy
    // tasks (~36 GB) fit the two usable nodes and every task places first try.
    // queueSize=3 STILL over-subscribed during the taxonomy/cleaning-contigs fan-out
    // (28 'failed placement' -> fatal on SEQKIT_FILTER): a 3rd in-flight task can't fit
    // the 2 usable nodes and times out. queueSize=2 puts exactly one task per usable
    // node (nomad02 24GB + nomad03 20GB) so every task places immediately (placement
    // failures -> 0). Slower but deterministic on this 3-node smoke cluster.
    queueSize = 2
}

process {
    // nextflow.config sets process.shell with '-C' (noclobber). That assumes each retry
    // runs in a FRESH work dir (true for standard executors), but nf-nomad does IN-PLACE
    // task restarts (same work dir on Nomad restart). On a restart a task's
    // `2> <prefix>.log` redirect then hits the leftover file from the previous attempt
    // and fails with "cannot overwrite existing file" — turning a transient first-attempt
    // failure into a fatal one (seen on BBMAP_MAPPING_CONTIGS and MMSEQ2_ETAXONOMY_NT).
    // Drop '-C' for cluster runs so in-place restarts can overwrite their own logs/outputs.
    shell = ['/bin/bash', '-e', '-u', '-o', 'pipefail']

    // resourceLimits is a *soft cap*; on this pipeline it does NOT clamp the
    // `memory = { N.GB * task.attempt }` closures in conf/base.config (verified:
    // tasks still requested 36/72 GB with only resourceLimits set). So we
    // OVERRIDE the per-label directives outright with absolute values that fit
    // the seedling nodes (my -c config is loaded last, so these win over
    // conf/base.config's same-label closures). Keep resourceLimits too as a backstop.
    resourceLimits = [ cpus: 16, memory: '20.GB', time: '24.h' ]

    withLabel:process_single      { cpus = 2;  memory = 4.GB  }
    withLabel:process_low         { cpus = 2;  memory = 6.GB  }
    withLabel:process_medium      { cpus = 6;  memory = 12.GB }
    withLabel:process_high        { cpus = 12; memory = 16.GB }
    withLabel:process_high_memory { cpus = 12; memory = 16.GB }

    // MMSEQ2_ETAXONOMY (esp. AA: sensitive search --start-sens 1 -s 7 vs the 3.3 GB viral
    // AA DB) OOM-killed at 12 GB. 18 GB was borderline on nomad03 (20 GB total) -> OOMed
    // intermittently. Bumped to 20 GB, but that only fits nomad02 (24 GB) EXCLUSIVELY —
    // with no scheduling flexibility, contention from other concurrent tasks on the same
    // node now causes 'failed placement' (task never gets an allocation at all, not OOM),
    // which with the pipeline default maxRetries=1 goes fatal. Raise maxRetries here so
    // transient placement contention on the single usable node gets absorbed instead of
    // exhausting retries.
    withName: '.*MMSEQ2_ETAXONOMY.*' {
        cpus       = 6
        memory     = 20.GB
        maxRetries = 5
    }

    // Smoke test: low min contig length so subsampled data still yields contigs.
    // Publication/real runs use '-m 3000'.
    withName: 'SEQKIT_FILTER' {
        ext.args = '-m 300'
    }

    // VRHYME_VRHYME is a dead-end in DENOVO_WF (its output is not emitted or consumed
    // downstream — denovo only emits MMSEQ2_ELINCLUST.out.rep_seq), and vRhyme fails
    // (exit 1) on the minimal lambda-spiked test contigs where there is too little to
    // bin. Don't let that abort the smoke test. (Revisit when the vrhyme integration
    // is actually wired into the outputs.)
    withName: 'VRHYME_VRHYME' {
        errorStrategy = 'ignore'
    }

    // BACPHLIP_LIFE_STYLE is also a dead-end in CLEANING_CONTIGS_WF (its output is not
    // emitted/consumed — the subworkflow only emits CheckV renamed_fasta + bbmap stats),
    // and bacphlip errors on the minimal lambda-spiked CheckV output (e.g. no genes to
    // classify). Don't let it abort the smoke test.
    withName: 'BACPHLIP_LIFE_STYLE' {
        errorStrategy = 'ignore'
    }
}

docker.registry = 'quay.io'

// Pin the nf-nomad-s5cmd plugin to the absolute path of the host-volume-mounted
// binary (the plugin's head-container auto-detection fails and otherwise falls back
// to a bare `s5cmd` that isn't on the worker PATH).
// NOTE: this only works once the worker can actually mount the `abc-tools` volume —
// patricia's Nomad token (policy su-everest-nf-admin) must be granted
// `host_volume "abc-tools" { policy = "write" }` (it currently only has `nf-work`).
// See abc-universe ADR-0061.
nomad {
    s5cmd {
        binary = '/nxf-work/bin/s5cmd'
    }
}
