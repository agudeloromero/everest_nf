{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListReadsFull",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::su-everest-nf"],
      "Condition": {"StringLike": {"s3:prefix": ["shared/everest/test_data/reads_full", "shared/everest/test_data/reads_full/*"]}}
    },
    {
      "Sid": "ReadWriteReadsFull",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::su-everest-nf/shared/everest/test_data/reads_full/*"]
    }
  ]
}
